import funkin.modding.module.Module;
import flixel.FlxG;
import funkin.ui.story.StoryMenuState;


class CL_ForceNormInStoryMenu extends Module {
    function new() {
        super("cl_forceNormInStoryMenu", 100, {state: StoryMenuState});
    }

    var weeksToForceNorm = ["cl-random-songs", "cl-random-songs-vol2", "cl-random-songs-vol3", "my-secret-santa-submissions"];

    override function onUpdate(e) {
        super.onUpdate(e);
        var state = FlxG.state;
        if (!(state is StoryMenuState)) return;
        for (week in weeksToForceNorm) {
            if (state.currentLevelId == week) {
                if (state.currentDifficultyId == "hard") state.changeDifficulty(-1);
                if (state.currentDifficultyId == "easy") state.changeDifficulty(1);
                else return;
            }

            if (state.currentLevelId == "my-secret-santa-submissions") {
                if (state.levelTitleText != null) state.levelTitleText.size = 24;
            } else {
                if (state.levelTitleText != null) state.levelTitleText.size = 32;
            }
            
        }
    }
}