import flixel.FlxG;

import funkin.modding.PolymodErrorHandler;

import funkin.ui.options.OptionsState;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.ScriptedModule;
import funkin.save.Save;
import funkin.modding.PolymodHandler;

class CL_SaveHandler extends ScriptedModule {
    function new() {
        super("cl-saveHandler", 2);
    }
    public var save:Save = Save.instance;
    public var options:Dynamic = {
        videoCoverOpacity: 50,
        bgVids: true,
        commentaryMode: false
    };

    override function onCreate(e) {
        super.onCreate(e);
        if (save.modOptions.get('chart-library') == null) {
            save.modOptions.set('chart-library', options);
            save.flush();
        } else {
            options = save.modOptions.get('chart-library');
        }
    }

    override function onStateChangeEnd(e) {
        super.onStateChangeEnd(e);
        if (Std.isOfType(e.targetState, OptionsState)) {
            var prefs = e.targetState.optionsCodex.pages.get('preferences'); 
            if (prefs != null) {

                prefs.createPrefItemPercentage("Video Cover Opacity", "Controls the background video's brightness by making a cover behind it, increase this if you have a harder time focusing on the notes.", (value:Int) -> {
                    options.videoCoverOpacity = value;
                }, options.videoCoverOpacity);

                prefs.createPrefItemCheckbox("Background Video", "Certain songs in My Chart Library have a background video that might stutter your game upon loading a song, unchecking this will disable the background video and use background images instead if found.", (value:Bool) -> {
                    options.bgVids = value;
                }, options.bgVids);

                prefs.createPrefItemCheckbox("Commentary Mode", "Some charts will have a guy yapping every now and then about the deep dank lore of the chart mid-game, NOT RECOMMENDED FOR A FIRST PLAYTHROUGH\nPRACTICE MODE IS RECOMMENDED.", (value:Bool) -> {
                    options.commentaryMode = value;
                }, options.commentaryMode);

            }
        } else {
            save.modOptions.set('chart-library', options);
            save.flush();
        }
    }
}
