import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.modding.module.ModuleHandler;
import funkin.graphics.FunkinSprite;
import funkin.Paths;
import flixel.util.FlxTimer;
import funkin.Assets;

import funkin.modding.PolymodErrorHandler;
import funkin.modding.PolymodHandler;
import funkin.Conductor;
import funkin.graphics.video.FunkinVideoSprite;
import funkin.play.Countdown;
import funkin.data.event.SongEventRegistry;
import funkin.data.song.SongEventDataRaw;
import funkin.modding.events.SongEventScriptEvent;
import haxe.Json;
import flixel.FlxG;
import funkin.save.Save;
import funkin.Preferences;
import funkin.util.Constants;

/*
    I shelve this mod frequently for days, so you might see lots of comments here
    Most of the code that handles the video playback (resync, accounting for pausing, resuming, etc) is copy pasted from the play video event by Abnormal
*/

class CL_Handler extends Module {
    public var jsonPath; // looks for the json file in the data folder
    public var jsonData:Dynamic; // Shortcut for Json.parse(Assets.getText(jsonPath))
    public var songsConfig:Array<Dynamic> = [];
    public var currentConfig:Dynamic = null;

    public var defaultBG_maxVal:Int = 2; // min is 1 not 0. Used for randomizing default BG and because I couldn't figure out a way to make the script know how many default BGs there are in the folder
    public var VIDEO_RESYNC_THRESHOLD:Int = 550; // The threshold for resyncing a video, in milliseconds
    public var DEFAULT_ANIM_FPS:Int = 10; // 10 FPS is good enough when converting a gif to a spritesheet - only used in my time 8 bit version with 3 FPS applied to it. It looked ✨awesome✨

    public var bgImage:FunkinSprite = null; // used for BG images when a song has no videos or when the player disables it
    public var isSparrow:Bool = false; // Used for animated BGs (meant to avoid using long looped videos as BGs)

    public var funkinVidSprite:FunkinVideoSprite = null; // video sprite
    public var vidCoverSprite:FunkinSprite = null; // The black cover that's placed in front of the video
    
    public var commentaryTexts = [];
    public var defaultCommentaryTexts = [
        "MAZ: Hi",
        "iH :ZAM",
        "MAZ: Ello",
        "MAZ: What up.",
        "MAZ: Are you on your phone?\nGood luck bruh.\nthat's alien playstyle for me...",
        "MAZ: Sorry if you missed a note while reading this.",
        "MAZ: Bump up the video cover opacity if you have a hard time reading the notes.",
        "MAZ: :thumbs-up:",
        "MAZ: If you think I'll laugh at you for sucking ass.\nDon't. Chances are I'm AFK.",
        "MAZ: Imagine shelving a mod for months\nand then end up finishing it within a couple of weeks.",
        "MAZ: Peace be upon you."
    ];
    public var text:FlxText = null; // text that appears in the left side of the screen

    public var transTimer:FlxTimer = null;
    public var fadeCommentaryTextTimer:FlxTimer = null;

    function new() {
        super("cl_handler");
        jsonPath = Paths.json("chartLibraryList");
        if (Assets.exists(jsonPath)) {
            jsonData = Json.parse(Assets.getText(jsonPath));
            songsConfig = jsonData.songs;
        }
    }

    function getConfigForCurrentSong():Dynamic {
        if (PlayState.instance == null) return;

        for (cfg in songsConfig) {
            if (cfg.songName == PlayState.instance.currentChart.songName || cfg.songName == PlayState.instance.currentSong.id) {
                return cfg; // checks whether songName is the song's in-game name/title or the song's internal name
            }
        }

        trace("Couldn't find config for " + PlayState.instance.currentSong.id);
        return;
    }

    function cleanupVisuals() {
        // Video
        if (funkinVidSprite != null) {
            PlayState.instance?.remove(funkinVidSprite);
            funkinVidSprite.destroy();
        }

        // Cover
        vidCoverSprite?.destroy();

        // BG image
        bgImage?.destroy();

        // Commentary text
        text?.destroy();
        commentaryTexts = [];
    }

    function applyVideoVolume() {
        if (funkinVidSprite?.bitmap == null) return;
        var mute = currentConfig?.muteVideo == true;
        funkinVidSprite.bitmap.volumeAdjust = mute ? 0 : 1.0;
    }

    function setupVideoBackground() {
        // Remove the current video
        funkinVidSprite?.destroy();

        // add the new one
        funkinVidSprite = new FunkinVideoSprite(0, 0);
        funkinVidSprite.zIndex = 500;
        funkinVidSprite.camera = PlayState.instance.camHUD;
        
        // scale the video to fit the screen while keepin the aspect ratio!
        funkinVidSprite?.bitmap?.onFormatSetup.add(() -> {
            var scale:Float = Math.min(
                FlxG.width / funkinVidSprite.bitmap.bitmapData.width,
                FlxG.height / funkinVidSprite.bitmap.bitmapData.height
            );

            funkinVidSprite?.setGraphicSize(
                (funkinVidSprite.bitmap.bitmapData.width * scale) + 10,
                funkinVidSprite.bitmap.bitmapData.height * scale
            );
            funkinVidSprite?.updateHitbox();
            funkinVidSprite?.screenCenter();
        });

        if (currentConfig?.loopVideo) funkinVidSprite.load(Paths.videos(PlayState.instance.currentSong.id + ".webm"), ["input-repeat=65535"]);
        else funkinVidSprite.load(Paths.videos(PlayState.instance.currentSong.id + ".webm"));
        PlayState.instance.add(funkinVidSprite);

        // old looping the video code
        
        // funkinVidSprite.bitmap.onEndReached.removeAll();
        // funkinVidSprite.bitmap.onEndReached.add(() -> {
        //     if (currentConfig?.loopVideo) {
        //         funkinVidSprite.bitmap.stop();
        //         funkinVidSprite.bitmap.time = 0;
        //         funkinVidSprite.bitmap.play();
        //     }
        // });
        

        // the cover sprite
        vidCoverSprite = new FunkinSprite();
        vidCoverSprite.makeSolidColor(FlxG.width * 2, FlxG.height * 2, 0xFF000000);
        vidCoverSprite.cameras = [PlayState.instance.camHUD];
        vidCoverSprite.alpha = Save.instance.modOptions.get("chart-library").videoCoverOpacity / 100;
        vidCoverSprite.zIndex = funkinVidSprite.zIndex + 1; // above the vid
        PlayState.instance.add(vidCoverSprite);
        PlayState.instance.refresh();
    }

    function setupImageBackground() {
        var songId = PlayState.instance.currentSong.id;
        var basePath = 'songs/$songId/bg';
        var xmlPath = Paths.file('images/$basePath.xml'); // images/songs/songID/bg.xml
        var pngPath = Paths.image(basePath); // images/songs/songID/bg.png

        if (Assets.exists(xmlPath)) {
            bgImage = new FunkinSprite().loadSparrow(basePath); // checks if the bg has an xml file, if it does, play its animation
            var fps = currentConfig?.bgAnimationFPS ?? DEFAULT_ANIM_FPS;
            bgImage.animation.addByPrefix('idle', 'idle0', fps, true);
            isSparrow = true;
            if (Preferences.flashingLights) bgImage.animation.play('idle'); // technically not needed but ehhh
        } else if (Assets.exists(pngPath)) {
            bgImage = new FunkinSprite().loadTexture(basePath); // otherwise it's just a static background image behind the hud
            isSparrow = false;
        } else if (currentConfig?.applyDefaultBGLogic == true) {
            var rand = FlxG.random.int(1, DEFAULT_BG_MAX); // if the song doesn't have a background, we use one of the defaults
            bgImage = new FunkinSprite().loadTexture('defaults/default_$rand'); // TODO: This should not be manual bruh. It should check how many default BGs there are in the folder
        } else {
            return; // My name is Void and my job is to bore you with this empty void and kill bind all kinds of colorful visuals to the point you quit the game
            // TODO: this is funny. put it in the game
        }

        // Scale and position
        var scale = Math.min(FlxG.width / bgImage.width, FlxG.height / bgImage.height);
        bgImage.setGraphicSize(bgImage.width * scale, bgImage.height * scale);
        bgImage.updateHitbox();
        bgImage.screenCenter();
        bgImage.scrollFactor.set(0, 0);
        bgImage.zIndex = 300;
        bgImage.cameras = [PlayState.instance.camGame];

        PlayState.instance?.currentStage?.add(bgImage);
    }

    function setupTextCommentary() {
        text?.destroy();

        text = new FlxText(20, 400, 300);
        text.text = "";
        text.setFormat(Paths.font("trebuc.ttf"), 15, FlxColor.fromRGB(229, 197, 16), "left", FlxTextBorderStyle.OUTLINE, 0xff000000);
        text.borderSize = 1;
        text.antialiasing = true;
        text.cameras = [PlayState.instance.camCutscene];
        text.alpha = 0.001;
        PlayState.instance.add(text);
    }

    function showComment(index:Int) {
        if (!Save.instance.modOptions.get("chart-library").commentaryMode) return; // The commentary is still on when the song loads but there won't be text mid-song

        fadeCommentaryTextTimer?.cancel();
        text.alpha = 1;
        text.text = commentaryTexts[index];
        FunkinSound.playOnce(Paths.sound("talk"));
        fadeCommentaryTextTimer = new FlxTimer().start(Conductor.instance.beatLengthMs * 16 / 1000, function(timer) {
            text.alpha = 0;
        });
    }

    override function onSongLoaded(e) {
        super.onSongLoaded(e);
        cleanupVisuals();
        
        if (!Assets.exists(jsonPath)) return;
        currentConfig = getConfigForCurrentSong();
        if (currentConfig == null) return;
        commentaryTexts = currentConfig.commentary;

        setupTextCommentary();

        // Messy af but whateva bro
        new FlxTimer().start(Conductor.instance.beatLengthMs * 3 / 1000, function(timer) {
            if (!PlayState.instance?.isGamePaused && PlayState.instance?.isInCountdown) {
                if (!currentConfig?.isSeriousSong) text?.text = defaultCommentaryTexts[FlxG.random.int(0, defaultCommentaryTexts.length)];
            } else {
                text?.text = "MAZ: Bro really paused the game during the countdown...";
            }
            if (!currentConfig?.isSeriousSong) text?.alpha = 1;
            if (!currentConfig?.isSeriousSong) FunkinSound.playOnce(Paths.sound("talk"));
            new FlxTimer().start(2, function(timer) {
                text?.text = "";
            });
        });

        trace("Loaded config for " + PlayState.instance.currentSong.id);
        trace("Commentary: " + Json.stringify(commentaryTexts));

        // Camera bop config
        execEvent("SetCameraBop", {
            intensity: (currentConfig?.init_BeatIntensity != null ? currentConfig?.init_BeatIntensity : 0.5),
            rate: currentConfig?.init_BeatRate
        });

        // UI tweaks
        PlayState.instance.opponentStrumline?.visible = false;
        PlayState.instance.playerStrumline?.x = FlxG.width / 2 - PlayState.instance.playerStrumline.width / 2;
        PlayState.instance.comboPopUps?.offsets = [400, 0]; // puts them to the right

        // Decide background type
        // bg vid is enabled and the video exists = play video
        // otherwise use imgs
        if (Save.instance.modOptions.get("chart-library").bgVids && Assets.exists(Paths.videos(PlayState.instance.currentSong.id + ".webm"))) setupVideoBackground();
        else setupImageBackground();
    }

    override function onSongStart(e) {
        super.onSongStart(e);

        if (!Assets.exists(jsonPath)) return;

        // Play video (the name must be the song's internal name)
        funkinVidSprite?.play();
        applyVideoVolume();
        
    }

    /**
    * Check and resync the video.
    * @param video The video data.
    * @param instant Resync the video instantly without checking.
    * @param resume Whether or not to resume the video after resyncing.
    */
    function checkResync(?instant:Bool = false, ?resume:Bool = true) {
        if (funkinVidSprite?.bitmap == null) return;
        if (currentConfig?.loopVideo) return;

        var expectedVideoTime:Float = Conductor.instance.songPosition - Conductor.instance.combinedOffset;
        var videoError:Float = funkinVidSprite.bitmap.time - expectedVideoTime;

        if (instant || Math.abs(videoError) > VIDEO_RESYNC_THRESHOLD) {
            trace('VIDEO NEEDS RESYNC!');
            trace('Video error: ' + Std.int(Math.abs(videoError)) + 'ms');
            trace('Resyncing video to ' + Std.int(expectedVideoTime) + 'ms (was ' + Std.int(funkinVidSprite.bitmap.time) + 'ms)');
            funkinVidSprite.pause();
            funkinVidSprite.bitmap.time = expectedVideoTime;
            if (resume) funkinVidSprite.resume();
        }
    }

    override function onCountdownStart(e) {
        super.onCountdownStart(e);
        if (Assets.exists(jsonPath) && currentConfig?.skipCountDown == true) {
            e.cancel();
        }
    }

    override function onSongRetry(e) {
        super.onSongRetry(e);
        cleanupVisuals();
        transTimer?.cancel();
    }

    override function onStepHit(e) {
        super.onStepHit(e);
        if (funkinVidSprite?.bitmap?.isPlaying) checkResync(false, true);
    }

    override function onPause(e) {
        super.onPause(e);
        funkinVidSprite?.pause();
        applyVideoVolume();
        checkResync(true, false);
        transTimer?.active = false;
        fadeCommentaryTextTimer?.active = false;
    }

    override function onResume(e) {
        super.onResume(e);
        applyVideoVolume();
        funkinVidSprite?.resume();
        transTimer?.active = true;
        fadeCommentaryTextTimer?.active = true;
    }

    override function onFocusGained(e) {
        super.onFocusGained(e);
        if (PlayState.instance?.isGamePaused) {
            funkinVidSprite?.pause();
            transTimer?.active = false;
            fadeCommentaryTextTimer?.active = false;
        }
    }

    override function onGameOver(e) {
        super.onGameOver(e);
        cleanupVisuals();
        transTimer?.cancel();
        fadeCommentaryTextTimer?.cancel();
    }

    override function onSongEnd(e) {
        super.onSongEnd(e);
        cleanupVisuals();
        transTimer?.cancel();
        fadeCommentaryTextTimer?.cancel();
    }



    /**
    * Triggers a song event. (credits to cyn0x8 on github.com)
    * 
    * @param kind The event kind.
    * @param value The event data.
    */
    public static function execEvent(kind:String, ?value:Dynamic) {
            if (PlayState.instance == null || Conductor.get_instance() == null) {
                return;
            }

            var event:SongEventDataRaw = new SongEventDataRaw(PlayState.instance.songPosition, kind, value);
            var scriptEvent:SongEventScriptEvent = new SongEventScriptEvent(event);
            if (!scriptEvent.eventCanceled) {
                SongEventRegistry.handleEvent(event);
            }

            PlayState.instance.dispatchEvent(scriptEvent);
    }

    // Definitely not stolen from FNF source code

    public function changeSection(sections:Int) {
      
        var targetTimeSteps:Float = Conductor.instance.currentStepTime + (Conductor.instance.stepsPerMeasure * sections);
        var targetTimeMs:Float = Conductor.instance.getStepTimeInMs(targetTimeSteps);
      
        // Don't go back in time to before the song started.
        targetTimeMs = Math.max(0, targetTimeMs);
      
        if (FlxG.sound.music != null) {
            FlxG.sound.music.time = targetTimeMs;
        }
      
        PlayState.instance.handleSkippedNotes();
        SongEventRegistry.handleSkippedEvents(PlayState.instance.songEvents, Conductor.instance.songPosition);
      
        Conductor.instance.update(FlxG.sound?.music?.time ?? 0.0);
        PlayState.instance.resyncVocals();
    }

    public function startTransTimer(?timer:Float = 20, ?musFadeTimer:Float = 10) {
        transTimer = new FlxTimer().start(timer, function(timer) {
            PlayState.instance?.endSong(true);
            FlxG.sound.music?.fadeOut(musFadeTimer, 0);
        });
    }
}